APP_NAME="Orisa CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=error

# MySQL (cPanel: use the database/user you created; host is usually localhost)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Shared-hosting friendly drivers (no Redis / queue worker needed)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Mail (configure real SMTP in production; never commit credentials)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Initial Super Administrator created by the seeder (first run only).
# Leave ADMIN_PASSWORD empty to have a random one generated and printed once.
# The account is forced to change its password at first login.
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
